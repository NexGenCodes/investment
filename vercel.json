{
  "crons": [
    {
      "path": "/api/cron/update-investments",
      "schedule": "0 0 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/cron/update-investments",
      "headers": [
        {
          "key": "x-cron-secret",
          "value": "@CRON_SECRET"
        }
      ]
    }
  ]
}

