<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <title>New Message Notification</title>
    <style>
        body {
            background: #f6f9fc;
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            color: #333;
        }

        .email-container {
            max-width: 600px;
            margin: 30px auto;
            background: #ffffff;
            border-radius: 8px;
            padding: 20px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .header {
            background-color: #3cb371;
            padding: 15px;
            text-align: center;
            border-radius: 8px 8px 0 0;
            color: #fff;
        }

        .header h1 {
            margin: 0;
            font-size: 22px;
        }

        .content {
            padding: 20px;
            font-size: 16px;
            line-height: 1.5;
        }

        .footer {
            text-align: center;
            padding: 10px;
            font-size: 12px;
            color: #888;
        }
    </style>
</head>

<body>
    <div class="email-container">
        <div class="header">
            <h1>New Message Received</h1>
        </div>
        <div class="content">
            <p>
                <%= message %>
            </p>
        </div>
        <div class="footer">
            <p>&copy; <%= new Date().getFullYear() %> Your Company. All rights reserved.</p>
        </div>
    </div>
</body>

</html>